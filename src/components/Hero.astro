---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  position?: string;
  fill?: boolean;
}

const { image, position = 'center', fill = false } = Astro.props;
const bg = await getImage({ src: image, width: 1920, format: 'webp' });
---

<section
  class:list={['hero', { 'hero--fill': fill }]}
  style={`background-image: url(${bg.src}); background-position: ${position};`}
>
  <div class="hero__inner">
    <slot />
  </div>
</section>
