---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  position?: string;
}

const { image, position = 'center' } = Astro.props;
const bg = await getImage({ src: image, width: 1920, format: 'webp' });
---

<section
  class="hero"
  style={`background-image: url(${bg.src}); background-position: ${position};`}
>
  <div class="hero__inner">
    <slot />
  </div>
</section>
