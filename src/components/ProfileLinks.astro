const visible = profiles.filter((profile) => profile.url);
---

{visible.length > 0 && (
  <ul class="profile-links">
    {visible.map((profile) => (
      <li>
        <a class="profile-link" href={profile.url}>
          <svg class="profile-link__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d={icons[profile.icon]} />
          </svg>
          {profile.label}
        </a>
      </li>
    ))}
  </ul>
)}
