---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import data from '../data/site.json';
import { inline } from '../lib/markdown';
import londonEye from '../assets/img/london-eye.jpg';

const { site, pages } = data;
const page = pages.home;
---

<Base title={site.homeTitle} bodyClass="home">
  <Hero image={londonEye} fill>
    <h1>{page.heading}</h1>
    {page.body.map((p) => <p set:html={inline(p)} />)}
    <ul class="hero__links">
      {page.links.map((link) => (
        <li><a href={link.path}>{link.label}</a></li>
      ))}
    </ul>
  </Hero>
</Base>
