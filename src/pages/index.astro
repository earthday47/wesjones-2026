---
import { Picture } from 'astro:assets';
import ProfileLinks from '../components/ProfileLinks.astro';
import Base from '../layouts/Base.astro';
import data from '../data/site.json';
import { inline } from '../lib/markdown';
import wesBass from '../assets/img/wes-on-stage.jpg';

const { site, pages } = data;
const page = pages.home;

// Each sentence starts a new line, and hyphenated words never split.
const headingLines = page.heading
  .split(/(?<=\.)\s+/)
  .map((line) => line.replace(/(\S+-\S+)/g, '<span class="nowrap">$1</span>'));
---

<Base title={site.homeTitle} bodyClass="home">
  <section class="split-hero">
    <div class="split-hero__text">
      <h1>{headingLines.map((line) => <span class="split-hero__line" set:html={line} />)}</h1>
      {page.body.map((p) => <p set:html={inline(p)} />)}
      <ul class="actions">
        {page.links.map((link, i) => (
          <li>
            <a class:list={['button', { 'button--secondary': i > 0 }]} href={link.path}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <ProfileLinks profiles={site.profiles} />
    </div>
    <figure class="split-hero__media">
      <Picture
        src={wesBass}
        formats={['avif', 'webp']}
        widths={[420, 648]}
        sizes="(min-width: 900px) 420px, 100vw"
        alt="Wes Jones playing bass on an outdoor stage at night."
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="split-hero__caption">{page.photoCredit}</figcaption>
    </figure>
  </section>

  <section class="section skills" aria-labelledby="skills-heading">
    <h2 class="section__heading" id="skills-heading">{page.skills.heading}</h2>
    <div class="skills__grid">
      {page.skills.groups.map((group) => (
        <div class="skills__group">
          <h3 class="skills__label">{group.label}</h3>
          <ul class="skills__list">
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Base>
