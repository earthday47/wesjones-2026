---
import Base from '../layouts/Base.astro';
import PhotoStack from '../components/PhotoStack.astro';
import DownloadIcon from '../components/DownloadIcon.astro';
import Timeline from '../components/Timeline';
import data from '../data/site.json';
import { inline } from '../lib/markdown';
import wesDrupalCon from '../assets/img/wes-drupalcon.jpg';
import wesThumbsUp from '../assets/img/wes-thumbs-up.jpg';
import wesDrupalSelfie from '../assets/img/wes-drupal-selfie.jpg';

const { site, pages } = data;
const page = pages.work;

const photos = [
  { image: wesDrupalCon, alt: 'Wes Jones wearing a DrupalCon Pittsburgh 2023 badge in front of the Drupal mascot.' },
  { image: wesThumbsUp, alt: 'Wes Jones giving two thumbs up in front of a giant inflatable Drupal drop at DrupalCon.' },
  { image: wesDrupalSelfie, alt: 'Wes Jones and a fellow developer taking a selfie with a Drupal mascot cutout in front of a T. rex model.' },
];
---

<Base title={`${page.heading} | ${site.name}`} bodyClass="work">
  <section class="split-hero">
    <div class="split-hero__text">
      <h1>{page.heading}</h1>
      <p set:html={inline(page.intro)} />
      <ul class="actions">
        <li><a class="button" href={site.resume}>{page.resumeButton}<DownloadIcon /></a></li>
      </ul>
    </div>
    <div class="split-hero__media">
      <PhotoStack photos={photos} />
    </div>
  </section>

  <section class="section">
    <h2 class="section__heading">{page.timelineHeading}</h2>
    <Timeline jobs={page.timeline} />
  </section>
</Base>
