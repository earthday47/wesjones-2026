---
import '../styles/global.css';
import data from '../data/site.json';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const { title, description = '', bodyClass = '' } = Astro.props;
const { site } = data;
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Red+Hat+Text:ital,wght@0,400;0,500;0,600;1,400&family=Red+Hat+Display:wght@600;700;800&family=Red+Hat+Mono:wght@500;600&display=swap"
    />
  </head>
  <body class={bodyClass}>
    <div class="page">
      <header class="site-header">
        <div class="container">
          <a class="site-brand" href="/">{site.name}</a>
          <nav aria-label="Main">
            <ul class="site-nav">
              {site.nav.map((item) => (
                <li>
                  <a href={item.path} aria-current={current === item.path ? 'page' : undefined}>
                    <span class="site-nav__label">{item.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </header>

      <main class="site-main container">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="container">
          <p>{site.copyright} {year}</p>
          <p>
            <a href={site.musicLink.url}>{site.musicLink.label}</a> <span aria-hidden="true">🪕</span>
          </p>
        </div>
      </footer>
    </div>
    <script is:inline>
      // Fades sections in as they scroll into view, staggered within a group.
      if (
        'IntersectionObserver' in window &&
        !matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        const items = document.querySelectorAll('.skills, .timeline__job');
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -10% 0px' }
        );
        items.forEach((el) => {
          const siblings = [...el.parentElement.children];
          el.style.transitionDelay = `${Math.min(siblings.indexOf(el), 3) * 80}ms`;
          el.classList.add('reveal');
          observer.observe(el);
        });
      }
    </script>
  </body>
</html>
